# Local settings. Application-core wiring is the next implementation milestone.
# Copy to .env and enter credentials locally. Never commit .env.
NIMBLE_API_KEY=

# Tinybird's event-linked RawTree service
RAWTREE_API_KEY=
RAWTREE_DATABASE=default
RAWTREE_BASE_URL=https://api.rawtree.com

# Local Liquid models, following the official Ollama guide.
# Keep the fast instruct model selected for extraction/gate experiments.
# Use the larger agent model for deeper post-wake reevaluation.
LIQUID_BASE_URL=http://localhost:11434/v1
LIQUID_MODEL=hf.co/LiquidAI/LFM2.5-1.2B-Instruct-GGUF
LIQUID_REEVALUATION_MODEL=hf.co/LiquidAI/LFM2.5-8B-A1B-GGUF

# AWS: use an authenticated profile; do not put AWS keys in the repository.
AWS_PROFILE=
AWS_REGION=
BEDROCK_MODEL_ID=
SPORE_TABLE_NAME=
SPORE_ARCHIVE_BUCKET=
